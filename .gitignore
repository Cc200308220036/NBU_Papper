# ========================================
# Python 缓存、测试缓存和构建产物
# ========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.eggs/

# ========================================
# 虚拟环境和本机工具目录
# ========================================
.venv/
venv/
env/
ENV/
.conda/
.cache/
.agents/
.codex/
.vscode/
.idea/

# ========================================
# 本地密钥与环境变量
# 示例文件保留，真实密钥文件禁止提交
# ========================================
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
credentials.json
secrets.json
/deepseek_api.md

# ========================================
# 系统和编辑器临时文件
# ========================================
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ========================================
# 不纳入本仓库的第三方项目与压缩包
