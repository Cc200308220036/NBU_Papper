    "empty": "placed slot 0 all zero valid only when empty; padding zero invalid; current valid",
    "mask": "true=valid; strictly mask padding in graph, glimpse and categorical; zero probability; no empty policy forward",
    "mapping": "C numeric display order → index (zero-based) → candidate ID/digest/exact pose+size/label; internal binding never network input",
    "ties": "smallest valid index for exact tie, evaluation argmax",
    "symmetric": "use original public dedup, no dedup in network",
    "failure": "reject duplicate/missing mapping, NaN, Inf, invalid index, bounds and shape mismatch",
    "load_edges": "only strictly positive increments; zero capacity with positive increment is contract error; empty set -> 0,0,false; floor without affected supports uses same",
