{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "pct_b1_task_v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_data_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_task_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "derived_task_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_component_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_partition": {
      "type": "string",
      "minLength": 1
    },
    "partition": {
      "type": "string",
      "minLength": 1
    },
    "exposure_status": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "minLength": 1
    },
    "parent_layer": {
      "type": "string",
      "minLength": 1
    },
    "container": {
      "type": "object",
      "properties": {
        "container_id": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_frame": {
          "const": "container_bottom_center"
        },
        "length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_payload_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "container_id",
        "coordinate_frame",
        "length_mm",
        "width_mm",
        "max_height_mm",
        "max_payload_kg"
      ],
      "additionalProperties": false
    },
    "arrival_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "dimensions_mm": {
            "type": "object",
            "properties": {
              "length": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "length",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stackable": {
            "type": "boolean"
          },
          "top_load_limit_kg_synthetic": {
            "type": "number",
            "minimum": 0
          },
          "fragile": {
            "type": "boolean"
          },
          "weight_class": {
            "enum": [
              "light",
              "medium",
              "heavy"
            ]
          },
          "product_category": {
            "const": "general"
          }
        },
        "required": [
          "item_id",
          "dimensions_mm",
          "mass_kg",
          "stackable",
          "top_load_limit_kg_synthetic",
          "fragile",
          "weight_class",
          "product_category"
        ],
        "additionalProperties": false
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "cargo_category": {
            "const": "general"
          },
          "packaging": {
            "const": {
              "reinforced": false
            }
          },
          "labels": {
            "type": "object",
            "properties": {
              "no_top_load": {
                "type": "boolean"
              },
              "max_top_load_kg": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "no_top_load",
              "max_top_load_kg"
            ],
            "additionalProperties": false
          },
          "physical_top_load_limit_kg": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "object_id",
          "cargo_category",
          "packaging",
          "labels",
          "physical_top_load_limit_kg"
        ],
        "additionalProperties": false
      }
    },
    "regions": {
      "const": []
    },
    "reference_policy": {
      "const": {
        "version": "jev_packaging_load_dataset_v1",
        "rules": []
      }
    },
    "instruction_text": {
      "const": "Packaging/load protocol v1: use current geometry, mass, support eligibility and capacity only."
    },
    "buffer_capacity": {
      "const": 1
    },
    "candidate_limits": {
      "const": {
        "per_box": 16,
        "joint": 48
      }
    }
  },
  "required": [
    "version",
    "task_id",
    "parent_data_identity",
    "parent_task_sha256",
    "parent_task_digest",
    "execution_spec_digest",
    "derived_task_digest",
    "source_component_id",
    "parent_partition",
    "partition",
    "exposure_status",
    "layer",
    "parent_layer",
    "container",
    "arrival_order",
    "items",
    "attributes",
    "regions",
    "reference_policy",
    "instruction_text",
    "buffer_capacity",
    "candidate_limits"
  ],
  "additionalProperties": false
}
