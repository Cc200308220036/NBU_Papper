{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "pct_b1_config_v1"
    },
    "model": {
      "enum": [
        null,
        "jev-1.14.0"
      ]
    },
    "buffer_capacity": {
      "const": 1
    },
    "candidate_backend": {
      "const": "e2_original_v1"
    },
    "per_object_top_k": {
      "const": 16
    },
    "joint_candidates_max": {
      "const": 48
    },
    "selectable_pool": {
      "const": "physical_feasible"
    },
    "policy_source": {
      "const": "packaging_physical_only"
    },
    "selector": {
      "enum": [
        "geometry_b1",
        "pct_geo_b1",
        "pct_load_b1",
        "jev_none_b1"
      ]
    },
    "feature_version": {
      "const": "packaging_physical_facts_v1"
    },
    "prompt_version": {
      "const": "packaging_load_en_v1"
    },
    "display_order_seed": {
      "const": 20261102
    },
    "max_request_bytes": {
      "const": 96000
    },
    "memory_mode": {
      "const": "none"
    },
    "experiment_protocol": {
      "const": "jev_packaging_runtime_v1"
    },
    "business_mode": {
      "const": "physical_only"
    },
    "execution_version": {
      "const": "physical_commit_v1"
    },
    "evaluation_version": {
      "const": "packaging_loading_metrics_v1"
    },
    "runtime_identity": {
      "type": "object",
      "properties": {
        "data_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "physical_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "strategy_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "monitor_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "data_identity",
        "physical_identity",
        "strategy_identity",
        "task_identity",
        "monitor_identity"
      ],
      "additionalProperties": false
    },
    "stability_monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "algorithm",
        "kernel_config",
        "algorithm_identity",
        "execution_environment"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "algorithm": {
          "enum": [
            "pct_exact_pose_network_v3",
            null
          ]
        },
        "kernel_config": {
          "type": [
            "object",
            "null"
          ]
        },
        "algorithm_identity": {
          "type": [
            "object",
            "null"
          ]
        },
        "execution_environment": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "pct_exact_pose_network_v3"
              },
              "kernel_config": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "algorithm",
                  "setting",
                  "height_tolerance_mm",
                  "mass_atol_kg",
                  "mass_rtol",
                  "moment_atol_kg_mm",
                  "moment_rtol",
                  "solver_tolerance",
                  "scaled_residual_tolerance",
                  "strict_interior_slack",
                  "certificate_gap",
                  "presolve",
                  "solver",
                  "selection"
                ],
                "properties": {
                  "algorithm": {
                    "const": "pct_exact_pose_network_v3"
                  },
                  "setting": {
                    "const": 1
                  },
                  "height_tolerance_mm": {
                    "const": 1e-06
                  },
                  "mass_atol_kg": {
                    "const": 1e-09
                  },
                  "mass_rtol": {
                    "const": 1e-09
                  },
                  "moment_atol_kg_mm": {
                    "const": 1e-06
                  },
                  "moment_rtol": {
                    "const": 1e-09
                  },
                  "solver_tolerance": {
                    "const": 1e-10
                  },
                  "scaled_residual_tolerance": {
                    "const": 1e-09
                  },
                  "strict_interior_slack": {
                    "const": 1e-10
                  },
                  "certificate_gap": {
                    "const": 1e-08
                  },
                  "presolve": {
                    "const": false
                  },
                  "solver": {
                    "const": "highs-ds"
                  },
                  "selection": {
                    "const": "max_network_interior_then_lexicographic_forces"
                  }
                }
              },
              "algorithm_identity": {
                "type": "object"
              },
              "execution_environment": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "algorithm": {
                "type": "null"
              },
              "kernel_config": {
                "type": "null"
              },
              "algorithm_identity": {
                "type": "null"
              },
              "execution_environment": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "execution_spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_identity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    }
  },
  "required": [
    "version",
    "model",
    "buffer_capacity",
    "candidate_backend",
    "per_object_top_k",
    "joint_candidates_max",
    "selectable_pool",
    "policy_source",
    "selector",
    "feature_version",
    "prompt_version",
    "display_order_seed",
    "max_request_bytes",
    "memory_mode",
    "experiment_protocol",
    "business_mode",
    "execution_version",
    "evaluation_version",
    "runtime_identity",
    "stability_monitor",
    "execution_spec_digest",
    "model_identity"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "selector": {
            "const": "jev_none_b1"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "const": "jev-1.14.0"
          }
        }
      },
      "else": {
        "properties": {
          "model": {
            "const": null
          }
        }
      }
    }
  ]
}
