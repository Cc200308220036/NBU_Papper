{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "pct_b1_constructed_execution_v1"
    },
    "scope": {
      "const": "P1B_CONSTRUCTED_ONLY"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "task_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "max_items": {
      "const": 3
    },
    "resume_admitted": {
      "const": false
    },
    "network_admitted": {
      "const": false
    }
  },
  "required": [
    "version",
    "scope",
    "job_id",
    "task_digest",
    "config_digest",
    "max_items",
    "resume_admitted",
    "network_admitted"
  ]
}
