{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_set.schema.json",
  "type": "object",
  "required": ["schema_version", "candidate_set_id", "scenario_id", "step_index", "physical_state_hash", "decision_context_hash", "generator", "coordinate_frame", "length_unit", "raw_candidate_count", "physical_valid_count", "returned_count", "candidate_order_seed", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_set_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "step_index": {"type": "integer", "minimum": 0},
    "physical_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator": {
      "type": "object", "required": ["name", "version", "config_hash", "top_k"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string"}, "version": {"type": "string"},
        "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "top_k": {"type": "integer", "minimum": 1}
      }
    },
    "coordinate_frame": {"const": "container_bottom_center"},
    "length_unit": {"const": "mm"},
    "raw_candidate_count": {"type": "integer", "minimum": 0},
    "physical_valid_count": {"type": "integer", "minimum": 1},
    "returned_count": {"type": "integer", "minimum": 1},
    "candidate_order_seed": {"type": "integer"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
  },
  "additionalProperties": false,
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "candidate_fingerprint", "pick_item_id", "pose", "oriented_size_mm", "ems", "support", "load", "resulting_geometry", "geometry_score_components", "physical_valid", "physical_rejection_reasons"],
      "additionalProperties": false,
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_fingerprint": {"type": "string", "minLength": 1},
        "pick_item_id": {"type": "string", "minLength": 1},
        "pose": {
          "type": "object", "required": ["x_mm", "y_mm", "z_base_mm", "yaw_deg"], "additionalProperties": false,
          "properties": {"x_mm": {"type": "number"}, "y_mm": {"type": "number"}, "z_base_mm": {"type": "number", "minimum": 0}, "yaw_deg": {"enum": [0, 90]}}
        },
        "oriented_size_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "ems": {
          "type": "object", "required": ["ems_id", "ems_type"], "additionalProperties": false,
          "properties": {"ems_id": {"type": "string"}, "ems_type": {"enum": ["floor_space", "supported_space"]}}
        },
        "support": {
          "type": "object", "required": ["support_item_ids", "support_ratio", "com_margin_mm"], "additionalProperties": false,
          "properties": {"support_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "support_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "com_margin_mm": {"type": "number"}}
        },
        "load": {
          "type": "object", "required": ["downward_load_kg", "minimum_remaining_capacity_kg"], "additionalProperties": false,
          "properties": {"downward_load_kg": {"type": "number", "minimum": 0}, "minimum_remaining_capacity_kg": {"type": ["number", "null"]}}
        },
        "resulting_geometry": {
          "type": "object", "required": ["max_height_mm", "volume_utilization", "center_of_mass_offset_mm"], "additionalProperties": false,
          "properties": {"max_height_mm": {"type": "number", "minimum": 0}, "volume_utilization": {"type": "number", "minimum": 0, "maximum": 1}, "center_of_mass_offset_mm": {"type": "number", "minimum": 0}}
        },
        "geometry_score_components": {
          "type": "object", "required": ["compactness", "height", "stability", "balance"], "additionalProperties": false,
          "properties": {"compactness": {"type": "number", "minimum": 0, "maximum": 1}, "height": {"type": "number", "minimum": 0, "maximum": 1}, "stability": {"type": "number", "minimum": 0, "maximum": 1}, "balance": {"type": "number", "minimum": 0, "maximum": 1}}
        },
        "physical_valid": {"const": true},
        "physical_rejection_reasons": {"type": "array", "maxItems": 0}
      }
    }
  }
}
