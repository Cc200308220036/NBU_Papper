{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ground_truth_rule.schema.json",
  "type": "object",
  "required": ["schema_version", "scenario_id", "ground_truth_rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario_id": {"type": "string"},
    "ground_truth_rules": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "source_order_id": {"type": "string"},
    "source_order_key": {"type": "string"},
    "source_article_ids": {"type": "array", "items": {"type": "string"}},
    "source_sequence_positions": {"type": "array", "items": {"type": "integer"}},
    "split": {"type": "string"},
    "split_group_id": {"type": "string"},
    "reference_feasible_plan_id": {"type": "string"},
    "paired_canonical_scenario_id": {"type": "string"}
  },
  "additionalProperties": false
}
