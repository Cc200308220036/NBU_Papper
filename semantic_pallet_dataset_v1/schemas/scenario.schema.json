{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "type": "object",
  "required": ["schema_version", "scenario_id", "container", "items", "arrival_order", "buffer_size", "instruction"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario_id": {"type": "string", "pattern": "^SCN_[0-9]{4}$"},
    "container": {
      "type": "object",
      "required": ["container_id", "length_mm", "width_mm", "max_height_mm", "max_payload_kg", "coordinate_frame"],
      "additionalProperties": false,
      "properties": {
        "container_id": {"type": "string"},
        "length_mm": {"type": "integer", "minimum": 1},
        "width_mm": {"type": "integer", "minimum": 1},
        "max_height_mm": {"type": "integer", "minimum": 1},
        "max_payload_kg": {"type": "number", "exclusiveMinimum": 0},
        "coordinate_frame": {"const": "container_bottom_center"}
      }
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "geometry_id", "dimensions_mm", "mass_kg", "weight_class", "material", "fragile", "stackable", "top_load_limit_kg_synthetic", "product_category"],
        "additionalProperties": false,
        "properties": {
          "item_id": {"type": "string"},
          "geometry_id": {"type": "string"},
          "dimensions_mm": {
            "type": "object", "required": ["length", "width", "height"], "additionalProperties": false,
            "properties": {"length": {"type": "integer", "minimum": 1}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
          },
          "mass_kg": {"type": "number", "exclusiveMinimum": 0},
          "weight_class": {"enum": ["light", "medium", "heavy"]},
          "material": {"enum": ["Cardboard", "Plastic", "Wood", "Metal", "Composite"]},
          "fragile": {"type": "boolean"},
          "stackable": {"type": "boolean"},
          "top_load_limit_kg_synthetic": {"type": "number", "minimum": 0},
          "product_category": {"enum": ["general", "electronics"]}
        }
      }
    },
    "arrival_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "buffer_size": {"enum": [1, 3]},
    "instruction": {
      "type": "object", "required": ["instruction_id", "text"], "additionalProperties": false,
      "properties": {"instruction_id": {"type": "string"}, "text": {"type": "string", "minLength": 1}}
    }
  },
  "additionalProperties": false
}
