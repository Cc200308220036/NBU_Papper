{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stream.schema.json",
  "type": "object",
  "required": ["schema_version", "stream_id", "stream_type", "memory_reset_group", "episodes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stream_id": {"type": "string"},
    "stream_type": {"enum": ["stationary", "policy_shift"]},
    "memory_reset_group": {"type": "string"},
    "episodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["episode_index", "scenario_id", "policy_version", "instruction"],
        "properties": {
          "episode_index": {"type": "integer", "minimum": 0},
          "scenario_id": {"type": "string"},
          "policy_version": {"type": "string"},
          "instruction": {"type": "string"},
          "change_event": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
