{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vlm_request.schema.json",
  "type": "object",
  "required": ["schema_version", "request_id", "state_hash", "instruction_text", "container", "placed_items", "available_items", "candidates", "visual_inputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "pallet_vlm_request_v1"},
    "request_id": {"type": "string"},
    "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instruction_text": {"type": "string", "minLength": 1},
    "container": {"type": "object"},
    "placed_items": {"type": "array"},
    "available_items": {"type": "array", "minItems": 1},
    "candidates": {"type": "array", "minItems": 1},
    "visual_inputs": {
      "type": "object", "required": ["workspace_image", "candidate_montage"], "additionalProperties": false,
      "properties": {"workspace_image": {"type": "string"}, "candidate_montage": {"type": "string"}}
    }
  }
}
