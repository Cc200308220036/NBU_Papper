{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "jev_selection_result_v1"
    },
    "status": {
      "enum": [
        "selected",
        "singleton",
        "provider_failure",
        "invalid_response",
        "budget_exhausted",
        "unknown_in_flight"
      ]
    },
    "selected_display_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^C[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "jev",
        "local_baseline",
        "test_double",
        "singleton"
      ]
    },
    "requested_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "served_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "probabilities": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1,
      "uniqueItems": true
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_s": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "local_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_response_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "status",
    "selected_display_id",
    "selected_candidate_id",
    "source",
    "requested_model",
    "served_model",
    "probabilities",
    "confidence",
    "attempt_ids",
    "usage",
    "latency_s",
    "local_binding_digest",
    "raw_response_digest",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "selected",
              "singleton"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "selected_display_id": {
            "type": "string",
            "pattern": "^C[0-9]{2}$"
          },
          "selected_candidate_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "selected_display_id": {
            "type": "null"
          },
          "selected_candidate_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
