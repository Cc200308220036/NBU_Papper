{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "geometry_fixture_execution_v1"
    },
    "task_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "const": "MANUAL_FIXTURE_ONLY"
    }
  },
  "required": [
    "version",
    "task_digest",
    "config_digest",
    "source_identity",
    "environment_digest",
    "scope"
  ]
}
