{
  "type": "object",
  "properties": {
    "version": {
      "const": "geometry_order_plan_v1"
    },
    "status": {
      "enum": [
        "DRAFT",
        "DEVELOPMENT_READY",
        "FROZEN"
      ]
    },
    "scope": {
      "enum": [
        "DEVELOPMENT_SYNTHETIC_ONLY",
        "KERNEL_ACCEPTANCE_SYNTHETIC_ONLY",
        "EXPOSED_TRAIN_LOCAL_ORDER_ONLY"
      ]
    },
    "data_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "enum": [
              "SYNTHETIC_FIXED",
              "EXPOSED_TRAIN"
            ]
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalized_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runtime_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "adapter_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "source_group_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "origin",
          "raw_sha256",
          "normalized_digest",
          "runtime_digest",
          "adapter_digest",
          "task_id",
          "source_group_id"
        ],
        "additionalProperties": false
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "backend": {
            "enum": [
              "e2_original_v1",
              "ems_surface_hybrid_v1"
            ]
          },
          "method": {
            "enum": [
              "local_geometry_test_double",
              "local_first_test_double"
            ]
          }
        },
        "required": [
          "job_id",
          "task_id",
          "backend",
          "method"
        ],
        "additionalProperties": false
      }
    },
    "feature_profile": {
      "const": "F0_existing_facts"
    },
    "event_limit": {
      "type": "null"
    },
    "extra_seeds": {
      "const": false
    },
    "model_calls_max": {
      "const": 0
    },
    "assessment_limit": {
      "type": "integer",
      "minimum": 0
    },
    "solver_limit": {
      "type": "integer",
      "minimum": 0
    },
    "call_ledger_path": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "version",
    "status",
    "scope",
    "data_identity",
    "source_identity",
    "environment_digest",
    "tasks",
    "jobs",
    "feature_profile",
    "event_limit",
    "extra_seeds",
    "model_calls_max",
    "assessment_limit",
    "solver_limit",
    "call_ledger_path"
  ],
  "additionalProperties": false
}
