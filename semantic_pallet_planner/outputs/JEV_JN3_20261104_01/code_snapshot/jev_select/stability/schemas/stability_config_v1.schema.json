{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "setting",
    "height_tolerance_mm",
    "mass_atol_kg",
    "mass_rtol"
  ],
  "properties": {
    "algorithm": {
      "const": "pct_static_v1"
    },
    "setting": {
      "const": 1
    },
    "height_tolerance_mm": {
      "const": 1e-06
    },
    "mass_atol_kg": {
      "const": 1e-09
    },
    "mass_rtol": {
      "const": 1e-09
    }
  }
}
