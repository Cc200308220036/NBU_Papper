{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "state_hash", "policy_digest", "instruction_text", "container", "placed_items", "available_items", "candidates", "buffer_size"],
  "properties": {
    "schema_version": {"const": "pallet_request_v2_pilot"},
    "request_id": {"type": "string", "pattern": "^V2_PILOT_[0-9]{3}_[01]$"},
    "state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instruction_text": {"type": "string", "minLength": 1},
    "buffer_size": {"const": 1},
    "container": {"type": "object", "required": ["length_mm", "width_mm", "max_height_mm", "max_payload_kg"],
      "properties": {"length_mm": {"type": "number", "exclusiveMinimum": 0}, "width_mm": {"type": "number", "exclusiveMinimum": 0}, "max_height_mm": {"type": "number", "exclusiveMinimum": 0}, "max_payload_kg": {"type": "number", "exclusiveMinimum": 0}}},
    "placed_items": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/item"}, {"required": ["pose", "oriented_size_mm", "supported_load_kg", "support_fractions"]}]}},
    "available_items": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/item"}},
    "candidates": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["display_label", "pick_item_id", "pose", "oriented_size_mm", "support", "load", "resulting_geometry", "geometry_score_components", "geometry_score", "public_relations"],
      "properties": {
        "display_label": {"type": "string", "pattern": "^C(0[1-9]|1[0-6])$"}, "pick_item_id": {"type": "string"},
        "pose": {"$ref": "#/$defs/pose"}, "oriented_size_mm": {"$ref": "#/$defs/dimensions"},
        "support": {"type": "object"}, "load": {"type": "object"}, "resulting_geometry": {"type": "object"},
        "geometry_score_components": {"type": "object"}, "geometry_score": {"type": "number"},
        "public_relations": {"type": "object", "additionalProperties": false, "required": ["before", "after", "delta"],
          "properties": {"before": {"type": "object"}, "after": {"type": "object"}, "delta": {"type": "object"}}}
      }
    }}
  },
  "$defs": {
    "pose": {"type": "object", "additionalProperties": false, "required": ["x_mm", "y_mm", "z_base_mm", "yaw_deg"],
      "properties": {"x_mm": {"type": "number"}, "y_mm": {"type": "number"}, "z_base_mm": {"type": "number", "minimum": 0}, "yaw_deg": {"enum": [0, 90]}}},
    "dimensions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
    "item": {"type": "object", "required": ["item_id", "dimensions_mm", "mass_kg", "weight_class", "fragile", "stackable", "top_load_limit_kg_synthetic", "product_category"],
      "properties": {"item_id": {"type": "string"}, "mass_kg": {"type": "number", "exclusiveMinimum": 0}, "fragile": {"type": "boolean"}, "stackable": {"type": "boolean"},
        "weight_class": {"enum": ["light", "medium", "heavy"]}, "product_category": {"type": "string"}, "top_load_limit_kg_synthetic": {"type": "number", "minimum": 0},
        "dimensions_mm": {"type": "object", "required": ["length", "width", "height"]}, "pose": {"$ref": "#/$defs/pose"}, "oriented_size_mm": {"$ref": "#/$defs/dimensions"}}}
  }
}
