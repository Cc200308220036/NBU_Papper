{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "o4_visual_facts_v1"
    },
    "rendering_version": {
      "const": "o4_public_render_v1"
    },
    "label_face_version": {
      "const": "o4_simulated_label_pos_x_v1"
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "const": "mm"
        },
        "mass": {
          "const": "kg"
        }
      },
      "required": [
        "length",
        "mass"
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_payload_kg": {
          "type": "number",
          "minimum": 0
        },
        "coordinate_frame": {
          "const": "container_bottom_center"
        }
      },
      "required": [
        "container_id",
        "length_mm",
        "width_mm",
        "max_height_mm",
        "max_payload_kg",
        "coordinate_frame"
      ]
    },
    "mode": {
      "enum": [
        "single",
        "buffer"
      ]
    },
    "buffer_capacity": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "end_of_stream": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "enum": [
              "placed",
              "pending"
            ]
          },
          "facts": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "object_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "mass_kg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "dimensions_mm": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "length": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "length",
                      "width",
                      "height"
                    ]
                  },
                  "cargo_category": {
                    "enum": [
                      "food",
                      "glassware",
                      "electronics",
                      "household_cleaner",
                      "general"
                    ]
                  },
                  "packaging": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "reinforced": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "reinforced"
                    ]
                  },
                  "labels": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "no_top_load": {
                        "type": "boolean"
                      },
                      "max_top_load_kg": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "no_top_load",
                      "max_top_load_kg"
                    ]
                  },
                  "physical_top_load_limit_kg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "stackable": {
                    "type": "boolean"
                  },
                  "fragile": {
                    "type": "boolean"
                  },
                  "weight_class": {
                    "enum": [
                      "light",
                      "medium",
                      "heavy"
                    ]
                  },
                  "pose": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x_mm": {
                        "type": "number"
                      },
                      "y_mm": {
                        "type": "number"
                      },
                      "z_base_mm": {
                        "type": "number",
                        "minimum": 0
                      },
                      "yaw_deg": {
                        "enum": [
                          0,
                          90
                        ]
                      }
                    },
                    "required": [
                      "x_mm",
                      "y_mm",
                      "z_base_mm",
                      "yaw_deg"
                    ]
                  },
                  "oriented_size_mm": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "object_id",
                  "mass_kg",
                  "dimensions_mm",
                  "cargo_category",
                  "packaging",
                  "labels",
                  "physical_top_load_limit_kg",
                  "stackable",
                  "fragile",
                  "weight_class",
                  "pose",
                  "oriented_size_mm"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "object_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "mass_kg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "dimensions_mm": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "length": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "height": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "length",
                      "width",
                      "height"
                    ]
                  },
                  "cargo_category": {
                    "enum": [
                      "food",
                      "glassware",
                      "electronics",
                      "household_cleaner",
                      "general"
                    ]
                  },
                  "packaging": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "reinforced": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "reinforced"
                    ]
                  },
                  "labels": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "no_top_load": {
                        "type": "boolean"
                      },
                      "max_top_load_kg": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "no_top_load",
                      "max_top_load_kg"
                    ]
                  },
                  "physical_top_load_limit_kg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "stackable": {
                    "type": "boolean"
                  },
                  "fragile": {
                    "type": "boolean"
                  },
                  "weight_class": {
                    "enum": [
                      "light",
                      "medium",
                      "heavy"
                    ]
                  }
                },
                "required": [
                  "object_id",
                  "mass_kg",
                  "dimensions_mm",
                  "cargo_category",
                  "packaging",
                  "labels",
                  "physical_top_load_limit_kg",
                  "stackable",
                  "fragile",
                  "weight_class"
                ]
              }
            ]
          },
          "slot": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2
          },
          "arrival_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "faces": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "face_id": {
                  "enum": [
                    "pos_x",
                    "neg_x",
                    "pos_y",
                    "neg_y",
                    "pos_z",
                    "neg_z"
                  ]
                },
                "local_normal": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "local_vertices_mm": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "world_normal": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "world_vertices_mm": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "face_id",
                "local_normal",
                "local_vertices_mm",
                "world_normal",
                "world_vertices_mm"
              ]
            }
          },
          "label": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "face_id": {
                "const": "pos_x"
              },
              "uv_rect": {
                "const": [
                  0.15,
                  0.25,
                  0.85,
                  0.75
                ]
              },
              "source": {
                "const": "accurate_simulated_public_print_layout"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "object_id": {
                    "type": "string"
                  },
                  "cargo_category": {
                    "enum": [
                      "food",
                      "glassware",
                      "electronics",
                      "household_cleaner",
                      "general"
                    ]
                  },
                  "reinforced": {
                    "type": "boolean"
                  },
                  "no_top_load": {
                    "type": "boolean"
                  },
                  "max_top_load_kg": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "object_id",
                  "cargo_category",
                  "reinforced",
                  "no_top_load",
                  "max_top_load_kg"
                ]
              }
            },
            "required": [
              "face_id",
              "uv_rect",
              "source",
              "payload"
            ]
          }
        },
        "required": [
          "object_id",
          "location",
          "facts",
          "slot",
          "arrival_index",
          "faces",
          "label"
        ]
      }
    },
    "facts_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "rendering_version",
    "label_face_version",
    "units",
    "container",
    "mode",
    "buffer_capacity",
    "end_of_stream",
    "objects",
    "facts_digest"
  ]
}
