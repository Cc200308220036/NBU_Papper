{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "geometry_jev_kernel_applicability_review_v1"
    },
    "status": {
      "const": "APPROVED"
    },
    "evidence_receipt": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "historical_source_manifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "historical_monitor": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "monitor_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "algorithm_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_version": {
          "const": "jev_packaging_geometry_jev_v18"
        }
      },
      "required": [
        "plan_digest",
        "source_identity",
        "environment_digest",
        "publication_policy_digest",
        "monitor_digest",
        "algorithm_digest",
        "runtime_version"
      ],
      "additionalProperties": false
    },
    "diff_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "before",
          "after",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "status",
    "evidence_receipt",
    "historical_source_manifest",
    "historical_monitor",
    "target",
    "diff_digest",
    "changes",
    "conclusion",
    "reviewer",
    "limitations"
  ],
  "additionalProperties": false
}
