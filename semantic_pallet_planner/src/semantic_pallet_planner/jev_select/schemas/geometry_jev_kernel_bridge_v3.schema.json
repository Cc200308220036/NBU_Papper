{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "geometry_jev_kernel_bridge_v3"
    },
    "status": {
      "const": "APPROVED"
    },
    "evidence_receipt": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "historical_source_manifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "historical_monitor": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "monitor_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "algorithm_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_version": {
          "const": "jev_packaging_geometry_jev_v19"
        }
      },
      "required": [
        "plan_digest",
        "source_identity",
        "environment_digest",
        "publication_policy_digest",
        "monitor_digest",
        "algorithm_digest",
        "runtime_version"
      ],
      "additionalProperties": false
    },
    "applicability_review": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "validation_mode": {
      "const": "REFERENCE_BINDINGS_ONLY_NO_HISTORICAL_EXECUTION"
    }
  },
  "required": [
    "version",
    "status",
    "evidence_receipt",
    "historical_source_manifest",
    "historical_monitor",
    "target",
    "applicability_review",
    "validation_mode"
  ],
  "additionalProperties": false
}
