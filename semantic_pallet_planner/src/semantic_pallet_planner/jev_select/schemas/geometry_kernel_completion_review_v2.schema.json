    },
    "status": {
      "const": "APPROVED"
    },
    "acceptance_plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counter_log": {
