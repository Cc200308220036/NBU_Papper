{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "execution_digest",
    "sequence",
    "previous_digest",
    "checkpoint",
    "record_digest"
  ],
  "properties": {
    "version": {
      "const": "jev_jm_checkpoint_journal_v1"
    },
    "execution_digest": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_digest": {
      "type": "string"
    },
    "checkpoint": {
      "type": "object"
    },
    "record_digest": {
      "type": "string"
    }
  }
}
