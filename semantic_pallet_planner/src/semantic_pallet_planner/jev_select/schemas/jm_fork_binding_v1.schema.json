{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "jev_jm_fork_binding_v1"
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "const": "jev_jm_fork_start_v1"
        },
        "evidence_scope": {
          "enum": [
            "CONSTRUCTED_ONLY",
            "ARCHIVED_ONLY_NOT_EXECUTION_ADMISSION"
          ]
        },
        "receipt": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pointer": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256",
            "pointer"
          ],
          "additionalProperties": false
        },
        "snapshot_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pointer": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256",
            "pointer"
          ],
          "additionalProperties": false
        },
        "task_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pointer": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256",
            "pointer"
          ],
          "additionalProperties": false
        },
        "snapshot": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "version": {
              "const": "jev_training_fork_v1"
            },
            "parent_identity": {
              "type": "object"
            },
            "decision_id": {
              "type": "string"
            },
            "parent_job_id": {
              "type": "string"
            },
            "record": {
              "type": "string"
            },
            "parent_record_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_group": {
              "type": "string"
            },
            "task_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "parent_config": {
              "type": "object"
            },
            "state": {
              "type": "object"
            },
            "cursor": {
              "type": "integer",
              "minimum": 0
            },
            "end_of_stream": {
              "type": "boolean"
            },
            "buffer": {
              "type": "array"
            },
            "pool": {
              "type": "object"
            },
            "mapping": {
              "type": "object"
            },
            "event": {
              "type": "object"
            },
            "field_evidence": {
              "type": "object"
            },
            "record_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "version",
            "parent_identity",
            "decision_id",
            "parent_job_id",
            "record",
            "parent_record_digest",
            "source_group",
            "task_digest",
            "parent_config",
            "state",
            "cursor",
            "end_of_stream",
            "buffer",
            "pool",
            "mapping",
            "event",
            "field_evidence",
            "record_digest"
          ],
          "additionalProperties": false
        },
        "task_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_receipt": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pointer": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256",
            "pointer"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "evidence_scope",
        "receipt",
        "snapshot_ref",
        "task_ref",
        "snapshot",
        "task_digest",
        "record_digest",
        "task_receipt"
      ],
      "additionalProperties": false
    },
    "start_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_identity": {
      "type": "object"
    },
    "forced_display_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "forced_candidate": {
      "type": "object"
    },
    "exact_action": {
      "type": "object"
    },
    "intervention": {
      "enum": [
        "ORIGINAL_ACTION_REFERENCE",
        "SAME_BOX_DIFFERENT_POSE",
        "CROSS_BOX_SELECTION"
      ]
    },
    "record_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "version",
    "branch_id",
    "start",
    "start_digest",
    "config_digest",
    "policy_identity",
    "forced_display_id",
    "forced_candidate",
    "exact_action",
    "intervention",
    "record_digest"
  ],
  "additionalProperties": false
}
