    },
    "storage_root": {
      "type": "string",
      "minLength": 1
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "global_max_sends": {
      "type": "integer",
      "minimum": 0
    },
    "record_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "version",
    "storage_root",
    "executions",
    "global_max_sends",
    "record_digest"
  ],
  "additionalProperties": false
}
