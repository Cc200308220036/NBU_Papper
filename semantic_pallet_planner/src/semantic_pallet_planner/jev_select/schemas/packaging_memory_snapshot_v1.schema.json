    },
    "mode": {
      "enum": [
        "T",
        "E"
      ]
    },
    "case_schema": {
      "type": "string"
    },
    "build_version": {
      "type": "string"
    },
    "build_method": {
      "type": "string"
    },
    "generation_model": {
      "type": [
        "string",
        "null"
      ]
    },
