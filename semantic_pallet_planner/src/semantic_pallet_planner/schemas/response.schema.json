{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "pallet_selector_response_v1"
    },
    "request_id": {
      "type": "string"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "state_hash",
    "candidate_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
